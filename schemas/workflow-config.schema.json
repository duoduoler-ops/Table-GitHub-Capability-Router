{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/duoduoler-ops/Table-GitHub-Capability-Router/main/schemas/workflow-config.schema.json",
  "title": "Agent Vault Workflow Configuration",
  "type": "object",
  "required": ["schema_version", "language", "client_profile", "paths", "route_categories"],
  "properties": {
    "schema_version": {"const": 2},
    "language": {"enum": ["zh-CN", "en"]},
    "client_profile": {"enum": ["generic-agent", "codex", "claude-code", "grok-build"]},
    "paths": {
      "type": "object",
      "required": [
        "project_records",
        "capability_records",
        "project_index",
        "semantic_router",
        "candidate_pool",
        "rejection_log",
        "router",
        "maintenance_log",
        "distillations",
        "inbox"
      ],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "route_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "label", "boundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "label": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
